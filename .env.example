# Copy to .env (never commit .env).

PORT=3000
NODE_ENV=development

# Signs login sessions. Required in production, at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# SMS.ir "verify" API for login codes. Without it, a development server shows the
# code on the login screen; a production server refuses to send codes.
SMS_IR_API_KEY=
SMS_TEMPLATE_ID=100000

# Comma-separated mobiles that may open the admin panel (banner, version, datasets, SFTP).
ADMIN_MOBILES=

# Browser origins allowed to call the API from another origin (the Android app's WebView).
CORS_ORIGINS=https://appassets.androidplatform.net

# Set to 1 when running behind one reverse proxy so rate limits see real client IPs.
TRUST_PROXY=

# Where users, cloud backups and datasets are stored (default: ./data).
DATA_DIR=

# Optional: SFTP target for publishing the APK from the admin panel.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_REMOTE_DIR=/

# Frontend build only: API origin when the UI is not served by this server.
VITE_API_BASE=
